// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Facility {
  id            String   @id @default(cuid())
  name          String   @db.VarChar(500)
  subcounty     String?  @db.VarChar(100) // Optional subcounty
  sublocation   String?  @db.VarChar(100) // Optional sublocation
  system        String   @db.VarChar(10) // NDWH or CBS
  location      String   @db.VarChar(50) // Kakamega, Vihiga, Nyamira, Kisumu
  isMaster      Boolean  @default(true) // true for master facilities, false for reported
  serverType    String?  @db.VarChar(50) // Server type group (A, B, C, etc.)
  routerType    String?  @db.VarChar(50) // Router type (auto-determined from router assets)
  facilityGroup String?  @db.VarChar(50) // Which sheet/group the facility belongs to
  simcardCount  Int? // Number of simcards the facility has
  hasLAN        Boolean  @default(false) // Whether facility has LAN available
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Asset details relationships
  servers       ServerAsset[]
  routers       RouterAsset[]
  simcards      SimcardAsset[]
  tablets       TabletAsset[]
  mobilePhones  MobilePhoneAsset[]
  lanAssets        LanAsset[]
  inventoryAssets  InventoryAsset[]
  criticalIssues   CriticalServerIssue[]

  @@index([system, location, isMaster])
  @@index([system, location])
  @@index([location, serverType])
  @@index([location, routerType])
  @@index([location, facilityGroup])
  @@index([location, hasLAN])
  @@map("facilities")
}

model CriticalServerIssue {
  id           String   @id @default(cuid())
  facilityId   String
  facility     Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  location     String   @db.VarChar(50)
  label        String   @db.VarChar(100)
  chip         String   @db.VarChar(50)
  problem      String   @db.Text
  solution     String?  @db.Text
  comment      String?  @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([location, isActive])
  @@index([facilityId])
  @@map("critical_server_issues")
}

model ServerAsset {
  id          String   @id @default(cuid())
  facilityId  String
  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  serverType  String   @db.VarChar(50) // e.g., "Dell Optiplex", "HP EliteDesk 800G1"
  assetTag    String?  @db.VarChar(100) // Asset tag number
  serialNumber String? @db.VarChar(100) // Serial number
  location    String   @db.VarChar(50) // Location for filtering
  subcounty   String?  @db.VarChar(100)
  sublocation String?  @db.VarChar(100)
  notes       String?  @db.Text // Additional notes
  assetStatus       String    @default("active") @db.VarChar(20)
  lostAt            DateTime?
  recoveredAt       DateTime?
  statusComment     String?   @db.Text
  storageLocation   String?   @db.VarChar(200)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([facilityId])
  @@index([location])
  @@index([location, assetStatus])
  @@index([assetStatus])
  @@index([assetTag])
  @@index([serialNumber])
  @@map("server_assets")
}

model RouterAsset {
  id          String   @id @default(cuid())
  facilityId  String
  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  routerType  String?  @db.VarChar(50) // Router model/type
  assetTag    String?  @db.VarChar(100) // Asset tag number
  serialNumber String? @db.VarChar(100) // Serial number
  location    String   @db.VarChar(50) // Location for filtering
  subcounty   String?  @db.VarChar(100)
  sublocation String?  @db.VarChar(100)
  notes       String?  @db.Text // Additional notes
  assetStatus       String    @default("active") @db.VarChar(20)
  lostAt            DateTime?
  recoveredAt       DateTime?
  statusComment     String?   @db.Text
  storageLocation   String?   @db.VarChar(200)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([facilityId])
  @@index([location])
  @@index([location, assetStatus])
  @@index([assetStatus])
  @@index([assetTag])
  @@index([serialNumber])
  @@map("router_assets")
}

model SimcardAsset {
  id          String   @id @default(cuid())
  facilityId  String
  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  phoneNumber String?  @db.VarChar(20) // Phone number/line
  assetTag    String?  @db.VarChar(100) // Asset tag number
  serialNumber String? @db.VarChar(100) // Serial number/ICCID
  provider    String?  @db.VarChar(50) // Service provider (Safaricom, Airtel, etc.)
  location    String   @db.VarChar(50) // Location for filtering
  subcounty   String?  @db.VarChar(100)
  sublocation String?  @db.VarChar(100)
  notes       String?  @db.Text // Additional notes
  assetStatus       String    @default("active") @db.VarChar(20)
  lostAt            DateTime?
  recoveredAt       DateTime?
  statusComment     String?   @db.Text
  storageLocation   String?   @db.VarChar(200)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([facilityId])
  @@index([location])
  @@index([location, assetStatus])
  @@index([assetStatus])
  @@index([assetTag])
  @@index([serialNumber])
  @@index([phoneNumber])
  @@map("simcard_assets")
}

model TabletAsset {
  id           String   @id @default(cuid())
  facilityId   String
  facility     Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  tabletType   String   @db.VarChar(50) // e.g., "Samsung Galaxy Tab A", "Lenovo Tab M10"
  assetTag     String?  @db.VarChar(100)
  serialNumber String?  @db.VarChar(100)
  location     String   @db.VarChar(50)
  subcounty    String?  @db.VarChar(100)
  sublocation  String?  @db.VarChar(100)
  notes        String?  @db.Text
  assetStatus       String    @default("active") @db.VarChar(20)
  lostAt            DateTime?
  recoveredAt       DateTime?
  statusComment     String?   @db.Text
  storageLocation   String?   @db.VarChar(200)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([facilityId])
  @@index([location])
  @@index([location, assetStatus])
  @@index([assetStatus])
  @@index([assetTag])
  @@index([serialNumber])
  @@map("tablet_assets")
}

model MobilePhoneAsset {
  id           String   @id @default(cuid())
  facilityId   String
  facility     Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  phoneModel   String   @db.VarChar(50) // e.g., "Samsung A14", "Tecno Spark"
  phoneNumber  String?  @db.VarChar(20)
  assetTag     String?  @db.VarChar(100)
  serialNumber String?  @db.VarChar(100)
  imei         String?  @db.VarChar(30)
  provider     String?  @db.VarChar(50)
  location     String   @db.VarChar(50)
  subcounty    String?  @db.VarChar(100)
  sublocation  String?  @db.VarChar(100)
  notes        String?  @db.Text
  assetStatus       String    @default("active") @db.VarChar(20)
  lostAt            DateTime?
  recoveredAt       DateTime?
  statusComment     String?   @db.Text
  storageLocation   String?   @db.VarChar(200)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([facilityId])
  @@index([location])
  @@index([location, assetStatus])
  @@index([assetStatus])
  @@index([assetTag])
  @@index([serialNumber])
  @@index([phoneNumber])
  @@map("mobile_phone_assets")
}

model LanAsset {
  id          String   @id @default(cuid())
  facilityId  String
  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  location    String   @db.VarChar(50) // Location for filtering
  subcounty   String?  @db.VarChar(100)
  hasLAN      Boolean  @default(false) // Whether facility has LAN
  lanType     String?  @db.VarChar(50) // Type of LAN (e.g., "Fiber", "Wireless")
  notes       String?  @db.Text // Additional notes
  assetStatus       String    @default("active") @db.VarChar(20)
  lostAt            DateTime?
  recoveredAt       DateTime?
  statusComment     String?   @db.Text
  storageLocation   String?   @db.VarChar(200)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([facilityId])
  @@index([location])
  @@index([location, assetStatus])
  @@index([assetStatus])
  @@map("lan_assets")
}

model Ticket {
  id              String    @id @default(cuid())
  facilityName    String    @db.VarChar(500) // Facility name (can paste from list)
  serverCondition String    @db.VarChar(200) // Server condition/status
  problem         String    @db.Text // Problem description
  solution        String?   @db.Text // How the problem was fixed
  reportedBy      String?   @db.VarChar(120) // Person reporting the ticket
  reporterRole    String?   @db.VarChar(100) // Role of reporter (HRIO, HMIS, M&E Associate, etc.)
  assignedTo      String?   @db.VarChar(120) // Person assigned to handle ticket
  reporterDetails String?   @db.Text // Optional reporter contact/extra details
  resolvedBy      String?   @db.VarChar(120) // Person who resolved the ticket
  resolverDetails String?   @db.Text // Optional resolver details
  resolutionSteps String?   @db.Text // Steps taken to resolve ticket
  status          String    @default("open") @db.VarChar(20) // open, resolved, in-progress
  location        String    @db.VarChar(50) // REQUIRED location (Kakamega, Vihiga, Nyamira, Kisumu)
  subcounty       String    @db.VarChar(100) // REQUIRED subcounty - for categorization
  serverType      String?   @db.VarChar(50) // Server type group (A, B, C, etc.)
  issueType       String?   @db.VarChar(20) // "server" or "network" - separates networking issues from server issues
  week            String?   @db.VarChar(50) // Week reference from ODS (e.g., "first week of jan")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  resolvedAt      DateTime? // When the ticket was resolved

  @@index([status])
  @@index([location])
  @@index([location, subcounty]) // For efficient filtering by location and subcounty
  @@index([subcounty]) // For categorization queries
  @@index([facilityName])
  @@index([serverType])
  @@index([issueType])
  @@map("tickets")
}

model AssetTypeDefinition {
  id          String   @id @default(cuid())
  slug        String   @unique @db.VarChar(50)
  label       String   @db.VarChar(100)
  pluralLabel String?  @db.VarChar(100)
  description String?  @db.Text
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields AssetTypeField[]
  assets InventoryAsset[]

  @@index([isActive, sortOrder])
  @@map("asset_type_definitions")
}

model AssetTypeField {
  id            String              @id @default(cuid())
  assetTypeId   String
  assetType     AssetTypeDefinition @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  key           String              @db.VarChar(50)
  label         String              @db.VarChar(100)
  fieldType     String              @db.VarChar(20) // text, number, boolean, select
  required      Boolean             @default(false)
  filterable    Boolean             @default(true)
  sortOrder     Int                 @default(0)
  selectOptions String?             @db.Text // JSON array of strings

  @@unique([assetTypeId, key])
  @@index([assetTypeId])
  @@map("asset_type_fields")
}

model InventoryAsset {
  id           String              @id @default(cuid())
  assetTypeId  String
  assetType    AssetTypeDefinition @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  facilityId   String
  facility     Facility            @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  location     String              @db.VarChar(50)
  subcounty    String?             @db.VarChar(100)
  assetTag     String?             @db.VarChar(100)
  serialNumber String?             @db.VarChar(100)
  notes        String?             @db.Text
  attributes   Json                @default("{}")
  assetStatus       String    @default("active") @db.VarChar(20)
  lostAt            DateTime?
  recoveredAt       DateTime?
  statusComment     String?   @db.Text
  storageLocation   String?   @db.VarChar(200)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([assetTypeId, location])
  @@index([facilityId])
  @@index([location])
  @@index([location, assetStatus])
  @@index([assetStatus])
  @@index([assetTag])
  @@index([serialNumber])
  @@map("inventory_assets")
}

model AppSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model ComparisonHistory {
  id                  String    @id @default(cuid())
  system              String    @db.VarChar(10) // CBS or NDWH
  location            String    @db.VarChar(50) // Nyamira, etc.
  uploadedFacilities  String    @db.Text // JSON array of facility names
  matchedCount        Int       @default(0)
  unmatchedCount      Int       @default(0)
  matchedFacilities   String    @db.Text // JSON array of matched facility names
  unmatchedFacilities String    @db.Text // JSON array of unmatched facility names
  week                String?   @db.VarChar(100) // Week string (e.g., "first week of february")
  weekDate            DateTime? // Date representing the week
  timestamp           DateTime  @default(now())
  createdAt           DateTime  @default(now())

  @@index([system, location])
  @@index([location, timestamp])
  @@index([location, week])
  @@map("comparison_history")
}
